# chartsnap: snapshot_version=v3
---
# Source: nn-devops-challenge/templates/service.yaml
apiVersion: v1
kind: Service
metadata:
  name: nn-devops-challenge
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: nn-devops-challenge
  ports:
  - port: 8080
    targetPort: 8080
---
# Source: nn-devops-challenge/templates/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: nn-devops-challenge
  labels:
    app.kubernetes.io/name: nn-devops-challenge
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: nn-devops-challenge
  template:
    metadata:
      labels:
        app.kubernetes.io/name: nn-devops-challenge
    spec:
      containers:
      - name: app
        image: "541872890146.dkr.ecr.eu-west-1.amazonaws.com/nn-devops-challenge:snapshot"
        imagePullPolicy: IfNotPresent
        ports:
        - containerPort: 8080
        env:
        - name: SPRING_PROFILES_ACTIVE
          value: "prod"
